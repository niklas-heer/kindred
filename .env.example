# Copy to .env and edit it. Compose reads .env for the settings below. .env is git-ignored: it can hold a setup code.
# docs/self-host.md explains each line.

# The address people open in the browser. Passkeys are bound to it, so set it before the first sign-in.
# With the https profile, use https://your.domain (the same as KINDRED_DOMAIN below). Without it, keep the default.
KINDRED_ORIGIN=http://localhost:4901

# The https profile only (docker compose --profile https up -d): the host name Caddy gets a certificate for.
KINDRED_DOMAIN=family.example.org
# How many reverse proxies stand in front of the app: 1 with the https profile (Caddy). The limits on signing in and on
# share links then count each visitor's own address, which Caddy passes on, instead of one limit for everyone. Empty
# without a proxy: the app then never believes the address a request claims for itself.
KINDRED_TRUSTED_PROXIES=

# Who may create the first account on a public address. Empty: the first person to reach /setup becomes the
# steward (the server warns about this). "required" (any case): a one-time code is printed in the logs at each start.
# Or a code of your own, 12 or more letters or digits, which stays the same until you change it. Any other value locks
# setup: nobody can create the first account until you fix it, and the server logs a warning saying so.
KINDRED_SETUP_CODE=
# 1, true, yes or required (any case) is the same as KINDRED_SETUP_CODE=required; 0, false, no or off (or empty) is
# not. Use one or the other. Any other value requires the code, to be safe, and the server logs a warning saying so.
KINDRED_REQUIRE_SETUP_CODE=

# How people sign in: exactly one mode per installation (docs/self-host.md, "Choosing how people sign in").
# kindred (or empty): Kindred's own accounts, with passkeys. Cloudflare Access tokens are ignored.
# passkey,password: the same, offering these ways in until the operator console saves its own choice.
# cloudflare-access: Cloudflare Access is the only sign-in, and both values below are required.
KINDRED_AUTH=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Break-glass for an operator who locked themselves out: these ways in (passkey,password) override the console's choice.
# Remove it once you can sign in and have fixed the console. Empty: the console decides.
KINDRED_AUTH_METHODS=

# With KINDRED_AUTH=cloudflare-access only: the second host name that share links point at, such as
# https://guests.family.example.org (docs/deploy-cloudflare.md, "Guests behind Access"). Empty otherwise.
KINDRED_GUEST_ORIGIN=

# The family that / opens directly, for its members. Empty: the family is called "family".
KINDRED_DEFAULT_TREE=

# KINDRED_JURISDICTION is for Cloudflare Workers only (docs/deploy-cloudflare.md, "One-click deploy"): Docker keeps the data
# where the server is, so Compose does not pass it.

# The key that seals the AI keys the stewards save. Empty: a generated key in the data volume (back it up with the
# data). If you set one, keep it the same: saved AI keys cannot be read with another one.
KINDRED_SECRET=

# Web Push reminders (docs/self-host.md, "Reminders"). Empty: reminders are off. Make the three values with
# `mise run vapid-keys -- mailto:you@example.org`. The private key is secret: it never belongs in the repository.
KINDRED_VAPID_PUBLIC_KEY=
KINDRED_VAPID_PRIVATE_JWK=
KINDRED_VAPID_SUBJECT=
# "off" stops the daily run (06:00 UTC) that sends the reminders. Empty or anything else keeps it on.
KINDRED_JOBS=
# off: the address box suggests towns only, and never sends typed addresses to OpenStreetMap (Photon). Empty: on.
KINDRED_ADDRESS_LOOKUP=
# Years of each family's change history the daily run keeps. Empty: 3. 0 keeps it for ever.
KINDRED_HISTORY_YEARS=

# Cloudflare Turnstile on the public request forms (/request, /privacy-request) of a server that hosts families for others.
# Both or neither: the site key goes to the browser, the secret stays here. See docs/hosting-many-families.md.
KINDRED_TURNSTILE_SITE_KEY=
KINDRED_TURNSTILE_SECRET=

# The operator console's update check (docs/hosting-many-families.md, "Updates"). It asks GitHub once a day, and only after an
# operator agrees in the console. `off` turns it off for good. A fork can name its own repository ("owner/name").
KINDRED_UPDATE_CHECK=
KINDRED_UPDATE_REPO=
# How the console's Updates tab says to update this server: docker (the image sets it), node, cloudflare, or github-actions
# (a copy made by the Deploy to Cloudflare button, which gets the Update button). Left out, it is guessed from where it runs.
# KINDRED_UPDATE_VIA=

# A public, read-only demo of invented families (docs/self-host.md, "A public demo"). Leave it empty for your family.
# 1: nobody signs in, every visitor reads every family as a viewer, and every change is refused. It cannot be combined with
# KINDRED_AUTH=cloudflare-access, CF_ACCESS_*, KINDRED_GUEST_ORIGIN, a setup code or the VAPID keys: the server then refuses
# to start. The demo profile (docker compose --profile demo up -d --build demo) sets it for its own service and data.
KINDRED_DEMO=
# The demo profile only: the address its demo is opened at (default http://localhost:4902).
KINDRED_DEMO_ORIGIN=

# 1 builds the offline place search into the image (it downloads GeoNames, about 40 MB, during the build).
WITH_GAZETTEER=0

# The commit shown in a steward's feedback report. The image build has no .git, so it says "unknown" unless you set it,
# on the command line rather than here: KINDRED_COMMIT=$(git rev-parse --short HEAD) docker compose up -d --build
# (Compose also reads a plain value from this file.)
# KINDRED_COMMIT=
