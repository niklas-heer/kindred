{
  "name": "kindred",
  "type": "module",
  "private": true,
  "imports": {
    "#store/driver": {
      "workerd": "./src/lib/store/cf.ts",
      "default": "./src/lib/store/node.ts"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "dev:cf": "node scripts/cf-migrate.ts --env local && CLOUDFLARE_ENV=local vite dev",
    "build": "vite build",
    "build:node": "KINDRED_TARGET=node vite build",
    "start": "node server/node.ts",
    "check": "tsc --noEmit",
    "test": "node --test src/lib/auth/*.test.ts src/lib/store/*.test.ts src/lib/*.test.ts src/lib/exchange/*.test.ts src/lib/i18n/*.test.ts src/lib/jobs/*.test.ts scripts/*.test.ts server/*.test.ts",
    "seed": "node scripts/seed.ts",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify/utils": "^3.1.7",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.22.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "d3-geo": "^3.1.2",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "srvx": "^1.0.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0",
    "yaml": "^2.9.1"
  }
}
