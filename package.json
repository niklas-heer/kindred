{
  "name": "kindred",
  "version": "2.5.0",
  "type": "module",
  "private": true,
  "imports": {
    "#store/driver": {
      "workerd": "./src/lib/store/cf.ts",
      "default": "./src/lib/store/node.ts"
    },
    "#store/durable": {
      "workerd": "./src/lib/store/durable.ts",
      "default": "./src/lib/store/durable.node.ts"
    },
    "#mail/smtp": {
      "workerd": "./src/lib/email/smtp.cf.ts",
      "default": "./src/lib/email/smtp.node.ts"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "dev": "vite dev",
    "dev:cf": "node scripts/cf-migrate.ts --env local && CLOUDFLARE_ENV=local vite dev",
    "build": "vite build",
    "build:node": "KINDRED_TARGET=node vite build",
    "start": "node server/node.ts",
    "check": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts' 'scripts/**/*.test.ts' 'server/**/*.test.ts'",
    "seed": "node scripts/seed.ts",
    "preview": "vite preview",
    "deploy": "vite build && node scripts/cf-migrate.ts --remote && wrangler deploy"
  },
  "cloudflare": {
    "bindings": {
      "KINDRED_SECRET": {
        "description": "A long random value that seals the AI keys stewards save, for example from `openssl rand -base64 32`. **Keep a copy**: saved AI keys cannot be read with another one."
      },
      "KINDRED_SETUP_CODE": {
        "description": "12 or more letters or digits. `/setup` asks for it, so nobody else can claim the new site before you. See [the guide](https://github.com/niklas-heer/kindred/blob/main/docs/deploy-cloudflare.md#one-click-deploy)."
      },
      "FAMILIES": {
        "description": "Durable Objects: one per family, and one for the accounts. Made by the Worker on first use; nothing to set."
      },
      "MEDIA": {
        "description": "The R2 bucket for pictures and documents."
      }
    }
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.23.1",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "d3-geo": "^3.1.2",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "modern-screenshot": "^4.7.0",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "srvx": "^1.0.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/parser": "^8.1.0",
    "@cloudflare/vite-plugin": "^1.68.0",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.65.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.160.0",
    "yaml": "^2.9.1"
  }
}
