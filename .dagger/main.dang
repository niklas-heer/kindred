"""
Reproducible CI for Kindred v2: the type check, the linter, the unit tests, the production Node build, the Worker build, the
Worker smoke test (workerd on local D1 and R2; it never contacts Cloudflare) and the Docker image build, started and asked for /api/health.

`mise run ci` runs the same checks locally. It needs a container engine: on macOS, `colima start`.
"""
type KindredCi {
  """
  What the checks read, as an allowlist: local data, secrets and build output stay out of every container. data/
  holds the family's real records and is never on this list.
  """
  let source: Directory! @defaultPath("/") @ignorePatterns([
    "*",
    "!src",
    "!server",
    "!scripts",
    "!migrations",
    "!public",
    "!package.json",
    "!package-lock.json",
    "!tsconfig.json",
    "!.oxlintrc.json",
    "!vite.config.ts",
    "!wrangler.jsonc",
    "!e2e",
    "!playwright.config.ts",
  ])

  """
  The Dockerfile's own build context, so the Dockerfile and .dockerignore are in it. This is a denylist, because the
  Dockerfile copies the whole project. Its paths are left out before upload, so data/ never reaches the engine.
  """
  let dockerContext: Directory! @defaultPath("/") @ignorePatterns([
    ".git",
    ".dagger",
    "data",
    "node_modules",
    "dist",
    ".output",
    ".tanstack",
    ".wrangler",
    ".dev.vars",
    ".env",
    ".env.*",
    "target",
    ".ruff_cache",
    "scratch",
    "test-results",
    ".DS_Store",
    "*.log",
  ])

  """
  The Node image the Dockerfile builds from (its Node version is the one in mise.toml), pinned by digest.
  """
  let node = "node:26-trixie-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072"

  """
  Node with the locked dependencies installed before the source is copied, so only a changed lockfile installs again.
  The npm cache is a cache volume scoped to this project.
  """
  let installed = container
    .from(node)
    .withWorkdir("/src")
    .withMountedCache("/root/.npm", cacheVolume("kindred-npm-cache"))
    .withFile("package.json", source.file("package.json"))
    .withFile("package-lock.json", source.file("package-lock.json"))
    .withExec(["npm", "ci"])
    .withDirectory("/src", source)

  """
  The installed project with the CA certificates workerd needs to start, for the steps that run it.
  """
  let withWorkerd = installed
    .withExec(["sh", "-c", "apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*"])

  """
  The type check: `npx tsc --noEmit`, over src, scripts and server.
  """
  pub typecheck: String! {
    installed.withExec(["npx", "tsc", "--noEmit"]).stdout
  }

  """
  The linter: `npm run lint` (oxlint), over the whole repository.
  """
  pub lint: String! {
    installed.withExec(["npm", "run", "lint"]).stdout
  }

  """
  The unit tests (`npm test`), including the database contract on local D1 in workerd. Nothing here reads data/ or
  contacts Cloudflare: the tests use scratch folders.
  """
  pub unitTests: String! {
    withWorkerd.withExec(["npm", "test"]).stdout
  }

  """
  The production build for Node (`npm run build:node`, the target of `mise run start`).
  """
  pub nodeBuild: String! {
    installed.withExec(["npm", "run", "build:node"]).stdout
  }

  """
  The Cloudflare Worker build (`npm run build`).
  """
  pub workerBuild: String! {
    installed.withExec(["npm", "run", "build"]).stdout
  }

  """
  The Worker smoke test (`scripts/worker-smoke.ts`): builds the Worker, runs it under workerd on empty local state and
  checks its routes, the security headers and the CSRF check. The script removes the Cloudflare credentials and routes
  every request through a closed proxy, so nothing leaves the container.
  """
  pub smoke: String! {
    withWorkerd
      .withExec(["node", "scripts/worker-smoke.ts"])
      .stdout
  }

  """
  The browser journeys (`e2e/`, `mise run e2e`) on Debian's Chromium: a production Node build, scratch data, the fake AI
  provider. Not in `ci` yet: add it once a run on a container engine has shown it green.
  """
  pub e2e: String! {
    installed
      .withExec(["sh", "-c", "apt-get update && apt-get install -y --no-install-recommends chromium && rm -rf /var/lib/apt/lists/*"])
      .withEnvVariable("KINDRED_E2E_BROWSER", "/usr/bin/chromium")
      .withExec(["npm", "run", "build:node"])
      .withExec(["npx", "playwright", "test"])
      .stdout
  }

  """
  The Docker image, built from the Dockerfile and not pushed. It is started as a service on its own port, and a second
  container asks it for /api/health: the run fails unless the server answers 200 and `ok`. A server that cannot start
  (a missing file in the image, a build that left something out) fails here, which `node --version` would not show.
  """
  pub docker: String! {
    container
      .from(node)
      .withServiceBinding("kindred", dockerContext.dockerBuild.withExposedPort(4901).asService)
      .withExec(["node", "-e", "fetch('http://kindred:4901/api/health').then(async (r) => { const t = await r.text(); console.log(r.status, t); process.exit(r.ok && t.trim() === 'ok' ? 0 : 1); }, (e) => { console.error(e); process.exit(1); })"])
      .stdout
  }

  """
  Every check CI requires. Evaluating the list runs them all, and any failing command fails the run.
  """
  pub ci: [String!]! {
    [typecheck, lint, unitTests, nodeBuild, workerBuild, smoke]
  }
}
