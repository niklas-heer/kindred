{
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "server/**/*.ts", "deploy/**/*.ts", "e2e/**/*.ts", "vite.config.ts", "playwright.config.ts"],
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "types": ["vite/client", "node"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": { "~/*": ["./src/*"] }
  }
}
